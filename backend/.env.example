# Ara backend — example environment (copy to .env for docker compose)
# NEVER commit real secrets.

# 32+ random bytes: openssl rand -hex 32
JWT_SECRET=dev-insecure-secret-change-me

# Postgres (metadata ONLY — no message content exists anywhere in the schema)
DATABASE_URL=postgres://ara:ara-dev-only@postgres:5432/ara

# Redis (presence/session state, cross-replica fan-out)
REDIS_URL=redis://redis:6379

# OTP: never expose debugCode outside development
OTP_DEBUG=0

# File relay caps
MAX_FILE_SIZE=2147483648

# FCM (production: wire firebase-admin with service credentials in services/push)
# FCM_CREDENTIALS_JSON=
