{
  "name": "ara-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Ara backend — metadata-only microservices: auth, signaling (WebSocket relay), presence, encrypted file relay, push gateway. Never sees or stores message content.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/local.ts",
    "start:auth": "node dist/services/auth/main.js",
    "start:signaling": "node dist/services/signaling/main.js",
    "start:presence": "node dist/services/presence/main.js",
    "start:file-relay": "node dist/services/file-relay/main.js",
    "start:push": "node dist/services/push/main.js",
    "test": "tsx --test --test-force-exit test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/rate-limit": "^9.1.0",
    "fastify": "^4.29.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
